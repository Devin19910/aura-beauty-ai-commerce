# ============================================
# AURA BEAUTY AI COMMERCE - Environment Config
# ============================================

# ============================================
# FRONTEND CONFIG (.env.local)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
NEXT_PUBLIC_MEILISEARCH_URL=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_PUBLIC_KEY=your_meilisearch_public_key

# ============================================
# BACKEND CONFIG
# ============================================
DATABASE_URL=postgresql://aura_user:aura_password@db:5432/aura_beauty_db
REDIS_URL=redis://cache:6379
SECRET_KEY=your_super_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# CLERK AUTH
# ============================================
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# ============================================
# STRIPE PAYMENTS
# ============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# AI PROVIDERS
# ============================================
CLAUDE_API_KEY=your_claude_api_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# ============================================
# EMAIL CONFIG (Resend)
# ============================================
RESEND_API_KEY=your_resend_api_key
SENDER_EMAIL=noreply@aurabeauty.com

# ============================================
# SEARCH CONFIG (Meilisearch)
# ============================================
MEILISEARCH_MASTER_KEY=your_meilisearch_master_key
MEILISEARCH_URL=http://localhost:7700

# ============================================
# CMS CONFIG (Sanity)
# ============================================
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_api_token

# ============================================
# AWS (Optional - for image storage)
# ============================================
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=aura-beauty-images

# ============================================
# ANALYTICS & MONITORING
# ============================================
SENTRY_DSN=your_sentry_dsn
MIXPANEL_TOKEN=your_mixpanel_token

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development
PYTHON_ENV=development
DEBUG=True

# ============================================
# API RATE LIMITING
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# ============================================
# CORS
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# WORKER/CELERY CONFIG
# ============================================
CELERY_BROKER_URL=redis://cache:6379/0
CELERY_RESULT_BACKEND=redis://cache:6379/1

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/aura.log
